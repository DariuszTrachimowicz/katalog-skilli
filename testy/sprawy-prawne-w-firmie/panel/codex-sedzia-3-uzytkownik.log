spec={\"KPA\":[\"37\",\"58\",\"63\",\"64\",\"65\"],\"OP\":[\"67a\",\"81\",\"141\",\"168\",\"169\",\"170\",\"222\"],\"DOREL\":[\"41\",\"42\"],\"PPSA\":[\"53\",\"54\"]}
