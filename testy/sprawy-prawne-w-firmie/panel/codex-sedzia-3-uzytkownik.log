import pathlib,json,re
root=pathlib.Path('skille/sprawy-prawne-w-firmie/references/akty')
spec={\"UPK\":[\"27\",\"30\",\"38\",\"43b\",\"43l\"],\"PRAUT\":[\"55\"],\"PWP\":[\"147\",\"152¹⁷\",\"153\"],\"ZNK\":[\"23\",\"27\"]}
out={}
for act,nums in spec.items():
 t=(root/(act+'.md')).read_text(encoding='utf-8')
 heads=list(re.finditer(r'(?m)"'^['"\\[<]?Art[.] (["'^.'"\\n]+)[.]',t))
 for num in nums:
  chunks=[t[m.start():(heads[i+1].start() if i+1<len(heads) else len(t))] for i,m in enumerate(heads) if m.group(1)==num]
  out[act+' '+num]='\\n'.join(chunks) if chunks else 'NOT FOUND'
print(json.dumps(out,ensure_ascii=True))
