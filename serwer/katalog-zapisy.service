[Unit]
Description=Katalog skilli — usluga zapisow z testu doboru
Documentation=file:/opt/katalog/README.md
After=network.target

[Service]
Type=simple
User=katalog
Group=katalog
WorkingDirectory=/opt/katalog
ExecStart=/usr/bin/node /opt/katalog/serwer/zapisy.mjs
Restart=always
RestartSec=3

# Usluga czyta konfiguracje i dane skilli, zapisuje wylacznie do /var/lib/katalog.
# Reszta systemu jest dla niej tylko do odczytu.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/katalog
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
SystemCallArchitectures=native

StandardOutput=journal
StandardError=journal
SyslogIdentifier=katalog-zapisy

[Install]
WantedBy=multi-user.target
